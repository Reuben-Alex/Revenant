{
  "version": "v1",
  "hooks": [
    {
      "name": "guard-data",
      "trigger": "PreToolUse",
      "description": "Block agent edits to public/data/; only the pipeline writes there.",
      "matcher": "fs_write|str_replace|fs_append|delete_file|smart_relocate",
      "action": {
        "type": "command",
        "command": "node scripts/guard-data.mjs"
      }
    }
  ]
}